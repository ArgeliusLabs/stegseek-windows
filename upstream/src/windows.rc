#include <winres.h>
1 RT_MANIFEST "windows.manifest"
1 VERSIONINFO
FILEVERSION 0,6,0,1
PRODUCTVERSION 0,6,0,1
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "StegSeek - unofficial native Windows port"
            VALUE "FileVersion", "0.6-win1"
            VALUE "OriginalFilename", "stegseek.exe"
            VALUE "ProductName", "StegSeek"
            VALUE "ProductVersion", "0.6-win1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
